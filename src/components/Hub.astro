---
import {ui,path,type Lang} from '../i18n/ui';
import {pillars} from '../data/pillars';
import {guides} from '../lib/guides';
import Cards from './Cards.astro';
import Newsletter from './Newsletter.astro';
interface Props{lang:Lang}
const {lang}=Astro.props,t=ui[lang],items=await guides(lang);
const keywords=[...new Set(items.map(g=>g.data.primaryKeyword))].slice(0,6);
---
<section class="hero"><span class="eyebrow">Jofoo AI / {t.home}</span><h1>{t.hero}</h1><p class="lead">{t.intro}</p><form id="search-form" role="search"><label for="search">{t.search}</label><div class="search-row"><input id="search" name="q" type="search" placeholder={t.searchPlaceholder}/><button>{t.search}</button></div></form><div class="chips">{keywords.map(k=><a class="chip" href={`${path(lang)}?q=${encodeURIComponent(k)}`}>{k}</a>)}</div><div id="search-results" aria-live="polite" data-lang={lang} data-loading={t.searching} data-empty={t.noResults} data-error={t.searchUnavailable}></div></section>
<section aria-label={t.all}><div class="chips" id="filters"><button data-filter="" aria-pressed="true">{t.all}</button>{Object.entries(pillars).map(([key,p])=><button data-filter={key} aria-pressed="false">{p[lang][0]}</button>)}</div>{items.length>0&&<p><span id="guide-count">{items.length}</span> {t.count}</p>}{items.length?<Cards items={items} lang={lang}/>:<p class="empty">{t.empty}</p>}<p id="filter-empty" hidden>{t.noResults}</p><noscript><nav>{Object.entries(pillars).map(([key,p])=><a href={path(lang,`topics/${key}`)}>{p[lang][0]}</a>)}</nav></noscript></section><Newsletter lang={lang}/><h2>{t.follow}</h2><nav><a href="https://www.youtube.com/@jofooai">YouTube</a><a href="https://www.instagram.com/jofooai">Instagram</a></nav>
<script>
const input=document.querySelector<HTMLInputElement>('#search')!;const results=document.querySelector<HTMLElement>('#search-results')!;
let request=0;
async function search(){const version=++request;const q=input.value.trim();const url=new URL(location.href);q?url.searchParams.set('q',q):url.searchParams.delete('q');history.replaceState(null,'',url);results.replaceChildren();if(!q)return;if(document.querySelectorAll('[data-guide-card]').length===0){results.textContent=results.dataset.empty!;return;}results.textContent=results.dataset.loading!;try{const modulePath='/jofooai/pagefind/pagefind.js';const pagefind=await import(/* @vite-ignore */ modulePath);await pagefind.options({baseUrl:'/jofooai/'});const response=await pagefind.search(q,{filters:{language:results.dataset.lang}});const matches=await Promise.all(response.results.map((r:{data:()=>Promise<{url:string;meta:{title:string}}>})=>r.data()));if(version!==request)return;results.replaceChildren();if(!matches.length)results.textContent=results.dataset.empty!;for(const match of matches){const p=document.createElement('p');const a=document.createElement('a');a.href=match.url;a.textContent=match.meta.title;p.append(a);results.append(p);}}catch{if(version===request)results.textContent=results.dataset.error!;}}
function filter(value:string){document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.filter===value)));let count=0;document.querySelectorAll<HTMLElement>('[data-guide-card]').forEach(card=>{card.hidden=!!value&&card.dataset.pillar!==value;if(!card.hidden)count++;});const counter=document.querySelector('#guide-count');if(counter)counter.textContent=String(count);document.querySelector<HTMLElement>('#filter-empty')!.hidden=count>0||!value||!counter;const url=new URL(location.href);value?url.searchParams.set('pillar',value):url.searchParams.delete('pillar');history.replaceState(null,'',url);}
document.querySelector('#search-form')!.addEventListener('submit',e=>{e.preventDefault();void search();});document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b=>b.addEventListener('click',()=>filter(b.dataset.filter!)));
const params=new URLSearchParams(location.search);input.value=params.get('q')??'';const initial=params.get('pillar')??'';if([...document.querySelectorAll<HTMLElement>('[data-filter]')].some(b=>b.dataset.filter===initial))filter(initial);if(input.value)void search();
</script>
